{
  "name": "@warpunit/slang-react",
  "version": "0.2.0",
  "description": "Dependency-free React client for the Slang translation service.",
  "license": "MIT",
  "author": "Nikita Zhuravlev <iam@niklucky.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niklucky/slang.git",
    "directory": "react"
  },
  "homepage": "https://github.com/niklucky/slang/tree/main/react#readme",
  "bugs": {
    "url": "https://github.com/niklucky/slang/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "slang": "bin/slang.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "happy-dom": "^15.11.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "i18n",
    "translations",
    "react",
    "react-native",
    "slang"
  ]
}
