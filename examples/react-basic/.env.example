# Both variables are OPTIONAL. Without them the app runs purely off the bundled
# ./src/locales files and never touches the network. Set them to test fetching
# from a live slang server.

# Project API key, sent as x-api-key. Create a project in the slang UI to get one.
VITE_SLANG_API_KEY=

# API origin. Defaults to same-origin, which Vite's dev proxy forwards to
# http://localhost:5801. Override to point at a proxy or production instead.
#VITE_SLANG_API_URL=
