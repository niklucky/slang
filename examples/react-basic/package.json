{
  "name": "slang-example-react-basic",
  "version": "0.0.0",
  "private": true,
  "description": "One-page example app that exercises @warpunit/slang-react.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @warpunit/slang-react build && vite",
    "build": "pnpm --filter @warpunit/slang-react build && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm --filter @warpunit/slang-react build && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@warpunit/slang-react": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  }
}
